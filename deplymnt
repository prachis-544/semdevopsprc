apiVersion: apps/v1
kind: Deployment
metadata:
 name: registration
spec:
 replicas: 2
 selector:
  matchLabels:
   app: registration
 template:
  metadata:
   labels:
    app: registration
  spec:
   containers:
   - name: registration
     image: my-reg
     ports:
     - containerPort: 80

---
apiVersion: v1
kind: Service
metadata:
 name: registration-service
spec:
 type: NodePort
 selector:
  app: registration
 ports:
 - port: 80
   targetPort: 80
   nodePort: 30080
